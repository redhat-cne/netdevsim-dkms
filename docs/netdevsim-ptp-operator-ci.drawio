        </mxCell>
        <mxCell id="flow1" value="1. configSwitch2  echo &gt; /sys/bus/netdevsim/new_device  →  kernel probe() creates NICs + /dev/ptp0 + /dev/gnss0 + DPLL devices" style="text;fontSize=10;fontColor=#333333;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="872" width="700" height="16" as="geometry" />
        </mxCell>
        <mxCell id="flow2" value="2. gnss-sim  write() → /dev/gnss0 (NMEA)  +  write() → .../dpll/lock_status (locked|holdover|freerun)  →  kernel DPLL state updates" style="text;fontSize=10;fontColor=#333333;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="892" width="800" height="16" as="geometry" />
        </mxCell>
        <mxCell id="flow3" value="3. ts2phc  read() /dev/gnss0 (NMEA 1PPS)  +  ioctl() /dev/ptp0 (discipline PHC from GNSS)" style="text;fontSize=10;fontColor=#333333;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="912" width="640" height="16" as="geometry" />
        </mxCell>
        <mxCell id="flow4" value="4. ptp4l  sendto()/recvfrom() ens1f0/ens1f1 (PTP L2)  +  ioctl() /dev/ptp0 (HW timestamps)" style="text;fontSize=10;fontColor=#333333;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="932" width="640" height="16" as="geometry" />
        </mxCell>
        <mxCell id="flow5" value="5. e810  genl sendmsg() → DPLL_CMD_DEVICE_GET → reads lock_status → cloud-event-proxy emits PTP event" style="text;fontSize=10;fontColor=#333333;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="952" width="700" height="16" as="geometry" />
        </mxCell>

